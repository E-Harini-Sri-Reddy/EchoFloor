# EchoFloor environment template.
# Copy to .env and replace placeholders. Do not commit .env.
# Never put server secrets in VITE_ variables — Vite embeds those in the browser bundle.

# -----------------------------------------------------------------------------
# Application environment
# Consumed by: server/src/config/env.ts
# -----------------------------------------------------------------------------
NODE_ENV=development

# -----------------------------------------------------------------------------
# Backend server
# Consumed by: server/src/index.ts and server/src/app.ts
# CLIENT_URL is the browser origin allowed by CORS. It is not a secret.
# -----------------------------------------------------------------------------
PORT=5000
CLIENT_URL=http://localhost:5173
SERVER_URL=http://localhost:5000
API_PREFIX=/api/v1

# -----------------------------------------------------------------------------
# Frontend configuration
# Consumed by: client/src/services/clientConfig.ts
# Every VITE_ variable is public client configuration.
# VITE_DATA_SOURCE=mock uses labeled browser-session fixtures.
# VITE_DATA_SOURCE=api loads organisation data from MongoDB via the Express API after sign-in.
# -----------------------------------------------------------------------------
VITE_APP_NAME=EchoFloor
VITE_API_BASE_URL=http://localhost:5000/api/v1
VITE_DATA_SOURCE=mock
# Public Google OAuth Web Client ID (same value as GOOGLE_CLIENT_ID below).
# Create an OAuth 2.0 Client ID of type "Web application" in Google Cloud Console.
# Authorized JavaScript origins: http://localhost:5173 (and your production origin).
# Authorized redirect URIs are not required for the GIS ID-token button flow.
VITE_GOOGLE_CLIENT_ID=

# -----------------------------------------------------------------------------
# MongoDB Atlas
# Consumed by: server/src/config/env.ts (connectivity is not opened in the UI mockup)
# Required in production. Leave blank locally until an Atlas cluster is provisioned.
# The health endpoint reports MongoDB as unavailable when MONGODB_URI is empty.
# -----------------------------------------------------------------------------
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_DATABASE=echofloor

# -----------------------------------------------------------------------------
# Authentication and security
# Consumed by: server/src/config/env.ts
# AUTH_SECRET is the server-only signing secret for future session or JWT auth.
# Do not also define a second JWT_SECRET. AUTH_TOKEN_EXPIRES_IN is the access-token lifetime.
# Required in production. The mockup does not issue real tokens.
# Generate a secret with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# -----------------------------------------------------------------------------
AUTH_SECRET=replace-with-a-long-random-secret
AUTH_TOKEN_EXPIRES_IN=8h

# -----------------------------------------------------------------------------
# Google OAuth
# Consumed by: server/src/config/env.ts and server/src/auth/google.ts
# GOOGLE_CLIENT_ID must match VITE_GOOGLE_CLIENT_ID. It is used to verify ID tokens.
# GOOGLE_CLIENT_SECRET is server-only. Keep it for the OAuth client credentials from
# Google Cloud Console (authorization-code flows). The GIS button flow verifies ID
# tokens with the client ID only; leave the secret blank only if you have not created
# a confidential client yet.
# -----------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# -----------------------------------------------------------------------------
# AI provider
# Consumed by: server/src/config/env.ts (not called by the browser)
# AI_API_KEY is the secret for whichever provider AI_PROVIDER names (for example groq or openai).
# Leave all three blank until a provider is selected. The assistant will show an unavailable state.
# -----------------------------------------------------------------------------
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=

# -----------------------------------------------------------------------------
# Embeddings
# Consumed by: server/src/config/env.ts
# EMBEDDING_API_KEY is optional when the embedding account is the same as AI_API_KEY.
# Do not set a frontend variable for this key.
# -----------------------------------------------------------------------------
EMBEDDING_PROVIDER=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
EMBEDDING_DIMENSIONS=

# -----------------------------------------------------------------------------
# n8n integration
# Consumed by: server/src/config/env.ts
# The browser must not call n8n webhook URLs directly.
# N8N_WEBHOOK_SECRET authenticates callbacks from n8n to this API (server-only).
# -----------------------------------------------------------------------------
N8N_BASE_URL=http://localhost:5678
N8N_WEBHOOK_SECRET=replace-with-a-long-random-webhook-secret

# -----------------------------------------------------------------------------
# Speech-to-text and voice processing
# Consumed by: server/src/config/env.ts
# AUDIO_MAX_BYTES is a non-secret upload limit for a future voice route. Default 10 MB.
# SPEECH_API_KEY stays on the server. Recording in the mockup stops with an unavailable state
# until transcription is implemented, even if a key is later provided.
# -----------------------------------------------------------------------------
SPEECH_PROVIDER=
SPEECH_API_KEY=
AUDIO_MAX_BYTES=10485760

# -----------------------------------------------------------------------------
# Optional
# Consumed by: server/src/config/env.ts
# -----------------------------------------------------------------------------
LOG_LEVEL=info
